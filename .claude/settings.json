{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(make governance)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make -f agk.mk agk-governance)",
      "Bash(make -f agk.mk agk-lint)",
      "Bash(make -f agk.mk agk-test)",
      "Bash(python3 scripts/agk/*)",
      "Bash(python3 -m pytest tests/kit*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin HEAD)"
    ],
    "ask": [
      "Edit(/constitution/**)",
      "Edit(/config/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/docs/requirements.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/scripts/agk/**)",
      "Edit(/tests/kit/**)",
      "Edit(/Makefile)",
      "Edit(/pyproject.toml)",
      "Edit(/agk.mk)",
      "Edit(/agk.toml)",
      "Edit(/kit/**)",
      "Edit(/tests/kit_dev/**)",
      "Edit(/.claude-plugin/**)",
      "Edit(/skills/**)",
      "Bash(python3 scripts/agk/merge_cleared.py*)",
      "Bash(python scripts/agk/merge_cleared.py*)",
      "Bash(*merge_cleared.py*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git reset * --hard*)",
      "Bash(gh pr merge:*)",
      "Bash(python3 scripts/agk/local_mode.py *--write*)",
      "Bash(python scripts/agk/local_mode.py *--write*)",
      "Bash(*local_mode.py*--write*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/secrets.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(!**/.env.example)",
      "Read(!**/tests/**)",
      "Read(!**/test/**)",
      "Read(!**/spec/**)",
      "Read(!**/__tests__/**)",
      "Read(!**/fixtures/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/data_guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_check.py"
          }
        ]
      }
    ]
  }
}
