#!/bin/sh
# agk: an optional git pre-push hook (brief #326, ADR-0186). The kit never installs it; a person who wants it copies it:
#   cp kit/templates/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# It runs the fast checks of scripts/agk/prepush.py before every push and stops the push when one fails.
# Add --quick to skip the tests, or --body FILE to check a pull request body. `git push --no-verify` skips the hook.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec python3 scripts/agk/prepush.py
